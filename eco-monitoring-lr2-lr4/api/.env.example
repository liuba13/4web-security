# Створюється як .env автоматично при першому `npm run dev` / `npm run seed`.
# Змінні читаються через `node --env-file=.env` (Node.js 20.6+).

# Драйвер бази даних:
#   mongo  — MongoDB; без MONGO_URL піднімається тимчасовий MongoDB у пам'яті
#   sqlite — локальний файл SQLite, без сервера БД (якщо mongo не запускається)
DB_DRIVER=mongo
# MONGO_URL=mongodb://127.0.0.1:27017
# SQLITE_FILE=./data/ecomonitoring.db

PORT=3000

# Секрет підпису токенів.
JWT_SECRET=

# Ключ доступу станцій моніторингу.
STATION_KEY=

# Дозволені джерела імпорту показників (host:port через кому).
IMPORT_ALLOWED_HOSTS=127.0.0.1:4100
